# Copy this file to .env and fill in real values.
# .env is gitignored — .env.example is the only one that should ever be committed.

# AWS (DynamoDB table + Transcribe + SES/SNS)
AWS_REGION=us-east-2
READING_APP_TABLE=ReadingAppTable

# S3 bucket for session audio + transcription output (transcription pipeline)
AUDIO_BUCKET=

# Email notifications (Amazon SES)
SES_FROM_EMAIL=
NOTIFICATION_EMAILS=

# SMS notifications — provider not yet decided (SNS vs Twilio)
# SNS uses your AWS credentials above, no separate keys needed.
# If using Twilio instead, uncomment and fill these in:
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Claude API (comprehension question generation)
ANTHROPIC_API_KEY=
